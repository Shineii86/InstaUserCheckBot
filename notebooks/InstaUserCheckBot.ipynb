   },
   "source": [
    "#@title ⚙️ 2. Configuration & Run\n",
    "\n",
    "# =============================================================================\n",
    "#  🔧 Telegram Configuration\n",
    "# =============================================================================\n",
    "\n",
    "TELEGRAM_BOT_TOKEN = \"\"  #@param {type:\"string\"}\n",
    "TELEGRAM_CHAT_ID = \"\"  #@param {type:\"string\"}\n",
    "\n",
    "# =============================================================================\n",
    "#  🎯 Username Generation Settings\n",
    "# =============================================================================\n",
    "\n",
    "USERNAME_LENGTH = 5  #@param {type:\"integer\"}\n",
    "CHARACTER_SET = \"1234567890qwertyuiopasdfghjklzxcvbnm._\"  #@param {type:\"string\"}\n",
    "AVOID_START_DOT = True  #@param {type:\"boolean\"}\n",
    "AVOID_END_DOT = True  #@param {type:\"boolean\"}\n",
    "AVOID_START_UNDERSCORE = False  #@param {type:\"boolean\"}\n",
    "AVOID_END_UNDERSCORE = False  #@param {type:\"boolean\"}\n",
    "AVOID_START_NUMBER = False  #@param {type:\"boolean\"}\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "#  Custom Wordlist (Optional) – one username per line\n",
    "# -----------------------------------------------------------------------------\n",
    "USE_CUSTOM_WORDLIST = False  #@param {type:\"boolean\"}\n",
    "WORDLIST_URL = \"\"  #@param {type:\"string\"}\n",
    "# If you want to upload a file manually, run the next cell after setting this to False.\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "#  Run Mode\n",
    "# -----------------------------------------------------------------------------\n",
    "MODE = \"continuous\"  #@param [\"continuous\", \"count\"]\n",
    "MAX_ATTEMPTS = 100  #@param {type:\"integer\"}\n",
    "\n",
    "# =============================================================================\n",
    "#  🚀 Performance & Anti-Ban Settings\n",
    "# =============================================================================\n",
    "\n",
    "USE_MULTITHREADING = True  #@param {type:\"boolean\"}\n",
    "MAX_WORKERS = 10  #@param {type:\"integer\"}\n",
    "DELAY_BETWEEN_REQUESTS = 0.5  #@param {type:\"number\"}\n",
    "USE_PROXY_LIST = False  #@param {type:\"boolean\"}\n",
    "PROXY_LIST_URL = \"\"  #@param {type:\"string\"}\n",
    "# Proxies should be one per line: http://user:pass@host:port or socks5://host:port\n",
    "\n",
    "# =============================================================================\n",
    "#  💾 Output Settings\n",
    "# =============================================================================\n",
    "\n",
    "SAVE_AVAILABLE_TO_FILE = True  #@param {type:\"boolean\"}\n",
    "OUTPUT_FILENAME = \"available_usernames.txt\"  #@param {type:\"string\"}\n",
    "\n",
    "# =============================================================================\n",
    "#  🛡️ Expiration (optional)\n",
    "# =============================================================================\n",
    "\n",
    "ENABLE_EXPIRATION = False  #@param {type:\"boolean\"}\n",
    "EXPIRATION_DATE = \"2099-01-01\"  #@param {type:\"string\"}\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "#  🖨️ Console Colors (for Colab output)\n",
    "# -----------------------------------------------------------------------------\n",
    "Z = '\\033[1;31m'  # Red\n",
    "X = '\\033[1;33m'  # Yellow\n",
    "F = '\\033[2;32m'  # Green\n",
    "C = '\\033[2;35m'  # Pink\n",
    "W = '\\033[1;37m'  # White\n",
    "\n",
    "# =============================================================================\n",
    "#  📦 Imports and Global Variables\n",
    "# =============================================================================\n",
    "\n",
    "import requests\n",
    "import random\n",
    "import time\n",
    "import threading\n",
    "from concurrent.futures import ThreadPoolExecutor, as_completed\n",
    "from datetime import datetime, timedelta\n",
    "import os\n",
    "import sys\n",
    "\n",
    "hit_count = 0\n",
    "checked_count = 0\n",
    "lock = threading.Lock()\n",
    "stop_flag = False\n",
    "available_usernames = []\n",
    "proxies_list = []\n",
    "\n",
    "# =============================================================================\n",
    "#  📡 Helper Functions\n",
    "# =============================================================================\n",
    "\n",
    "def send_telegram_message(text):\n",
    "    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:\n",
    "        return\n",
    "    url = f\"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage\"\n",
    "    data = {\"chat_id\": TELEGRAM_CHAT_ID, \"text\": text, \"parse_mode\": \"HTML\"}\n",
    "    try:\n",
    "        requests.post(url, data=data, timeout=10)\n",
    "    except:\n",
    "        pass\n",
    "\n",
    "def load_proxies():\n",
    "    global proxies_list\n",
    "    if not USE_PROXY_LIST or not PROXY_LIST_URL:\n",
    "        return\n",
    "    try:\n",
    "        resp = requests.get(PROXY_LIST_URL, timeout=15)\n",
    "        proxies_list = [line.strip() for line in resp.text.splitlines() if line.strip()]\n",
    "        print(f\"{W}[+] Loaded {len(proxies_list)} proxies.\")\n",
    "    except Exception as e:\n",
    "        print(f\"{Z}[!] Failed to load proxies: {e}\")\n",
    "\n",
    "def get_random_proxy():\n",
    "    if not proxies_list:\n",
    "        return None\n",
    "    proxy = random.choice(proxies_list)\n",
    "    return {\"http\": proxy, \"https\": proxy}\n",
    "\n",
    "def get_csrf_token(session):\n",
    "    \"\"\"Fetch a fresh CSRF token using the provided session.\"\"\"\n",
    "    url = \"https://www.instagram.com/accounts/emailsignup/\"\n",
    "    headers = {\n",
    "        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:91.0) Gecko/20100101 Firefox/91.0',\n",
    "    }\n",
    "    try:\n",
    "        response = session.get(url, headers=headers, timeout=15)\n",
    "        if \"csrftoken\" in session.cookies:\n",
    "            return session.cookies[\"csrftoken\"]\n",
    "    except:\n",
    "        pass\n",
    "    return None\n",
    "\n",
    "def check_username(username):\n",
    "    \"\"\"Check a single username. Returns True if available, False otherwise.\"\"\"\n",
    "    global checked_count, hit_count, available_usernames\n",
    "    \n",
    "    session = requests.Session()\n",
    "    if USE_PROXY_LIST and proxies_list:\n",
    "        session.proxies.update(get_random_proxy())\n",
    "    \n",
    "    csrf_token = get_csrf_token(session)\n",
    "    if not csrf_token:\n",
    "        with lock:\n",
    "            print(f\"{Z}[!] Failed to get CSRF token. Skipping check.\")\n",
    "        return False\n",
    "    \n",
    "    url = 'https://www.instagram.com/accounts/web_create_ajax/attempt/'\n",
    "    headers = {\n",
    "        'Host': 'www.instagram.com',\n",
    "        'Content-Type': 'application/x-www-form-urlencoded',\n",
    "        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:91.0) Gecko/20100101 Firefox/91.0',\n",
    "        'X-IG-App-ID': '936619743392459',\n",
    "        'X-CSRFToken': csrf_token,\n",
    "        'Referer': 'https://www.instagram.com/accounts/emailsignup/',\n",
    "    }\n",
    "    data = {\n",
    "        'email': 'example@gmail.com',\n",
    "        'username': username,\n",
    "        'first_name': '',\n",
    "        'opt_into_one_tap': 'false'\n",
    "    }\n",
    "    \n",
    "    try:\n",
    "        response = session.post(url, headers=headers, data=data, timeout=15)\n",
    "        text = response.text\n",
    "        \n",
    "        with lock:\n",
    "            checked_count += 1\n",
    "            \n",
    "        if \"feedback_required\" in text:\n",
    "            with lock:\n",
    "                print(f\"{W} [+] {Z}Rate limited on: {X}{username}\")\n",
    "            return False\n",
    "        elif \"username_is_taken\" in text:\n",
    "            with lock:\n",
    "                print(f\"{W} [+] {Z}Taken: {X}{username}\")\n",
    "            return False\n",
    "        else:\n",
    "            # Available\n",
    "            with lock:\n",
    "                hit_count += 1\n",
    "                available_usernames.append(username)\n",
    "                print(f\"{W} [+] {F}AVAILABLE: {C}{username}\")\n",
    "                message = f\"\"\"\n",
    "✅ Instagram Username Available\n",
    "━━━━━━━━━━━━━━━━━━\n",
    "💀 Hit #{hit_count}\n",
    "💀 Username: @{username}\n",
    "💀 Status: Available 👍\n",
    "━━━━━━━━━━━━━━━━━━\n",
    "💀 Checked so far: {checked_count}\n",
    "\"\"\"\n",
    "                send_telegram_message(message)\n",
    "                if SAVE_AVAILABLE_TO_FILE:\n",
    "                    with open(OUTPUT_FILENAME, 'a') as f:\n",
    "                        f.write(username + '\\n')\n",
    "            return True\n",
    "    except Exception as e:\n",
    "        with lock:\n",
    "            print(f\"{Z}[!] Error checking {username}: {e}\")\n",
    "        return False\n",
    "    finally:\n",
    "        time.sleep(DELAY_BETWEEN_REQUESTS)\n",
    "\n",
    "def username_generator():\n",
    "    \"\"\"Generator that yields valid usernames based on settings.\"\"\"\n",
    "    chars = CHARACTER_SET\n",
    "    while not stop_flag:\n",
    "        username = ''.join(random.choice(chars) for _ in range(USERNAME_LENGTH))\n",
    "        # Apply filters\n",
    "        if AVOID_START_DOT and username[0] == '.':\n",
    "            continue\n",
    "        if AVOID_END_DOT and username[-1] == '.':\n",
    "            continue\n",
    "        if AVOID_START_UNDERSCORE and username[0] == '_':\n",
    "            continue\n",
    "        if AVOID_END_UNDERSCORE and username[-1] == '_':\n",
    "            continue\n",
    "        if AVOID_START_NUMBER and username[0].isdigit():\n",
    "            continue\n",
    "        yield username\n",
    "\n",
    "def load_custom_wordlist():\n",
    "    \"\"\"Load usernames from a URL or uploaded file.\"\"\"\n",
    "    if not USE_CUSTOM_WORDLIST:\n",
    "        return []\n",
    "    if WORDLIST_URL:\n",
    "        try:\n",
    "            resp = requests.get(WORDLIST_URL, timeout=15)\n",
    "            return [line.strip() for line in resp.text.splitlines() if line.strip()]\n",
    "        except Exception as e:\n",
    "            print(f\"{Z}[!] Failed to load wordlist: {e}\")\n",
    "            return []\n",
    "    else:\n",
    "        # Option to upload file manually (can be done via Colab's file upload)\n",
    "        from google.colab import files\n",
    "        print(f\"{W}Please upload your wordlist file:\")\n",
    "        uploaded = files.upload()\n",
    "        for filename in uploaded.keys():\n",
    "            with open(filename, 'r') as f:\n",
    "                return [line.strip() for line in f if line.strip()]\n",
    "    return []\n",
    "\n",
    "def check_expiration():\n",
    "    if not ENABLE_EXPIRATION:\n",
    "        return False\n",
    "    try:\n",
    "        exp_date = datetime.strptime(EXPIRATION_DATE, \"%Y-%m-%d\")\n",
    "        if datetime.now() > exp_date:\n",
    "            print(f\"{Z}[!] This script has expired. Please contact the developer.\")\n",
    "            return True\n",
    "    except:\n",
    "        pass\n",
    "    return False\n",
    "\n",
    "# =============================================================================\n",
    "#  🚀 Main Execution\n",
    "# =============================================================================\n",
    "\n",
    "if check_expiration():\n",
    "    send_telegram_message(\"❌ InstaUserCheckBot has expired.\")\n",
    "    sys.exit(1)\n",
    "\n",
    "if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:\n",
    "    print(f\"{Z}[!] Please provide Telegram Bot Token and Chat ID.\")\n",
    "    sys.exit(1)\n",
    "\n",
    "print(f\"{W}\\n🔍 InstaUserCheckBot Starting...\")\n",
    "print(\"=\"*50)\n",
    "send_telegram_message(\"🤖 InstaUserCheckBot started. Checking usernames...\")\n",
    "\n",
    "load_proxies()\n",
    "\n",
    "# Prepare username source\n",
    "custom_list = load_custom_wordlist() if USE_CUSTOM_WORDLIST else []\n",
    "if custom_list:\n",
    "    print(f\"{W}[+] Loaded {len(custom_list)} usernames from wordlist.\")\n",
    "    username_iter = iter(custom_list)\n",
    "else:\n",
    "    username_iter = username_generator()\n",
    "\n",
    "# Main loop\n",
    "attempts = 0\n",
    "max_workers = MAX_WORKERS if USE_MULTITHREADING else 1\n",
    "\n",
    "try:\n",
    "    with ThreadPoolExecutor(max_workers=max_workers) as executor:\n",
    "        futures = set()\n",
    "        \n",
    "        while not stop_flag:\n",
    "            # Check if we've reached max attempts (if in count mode)\n",
    "            if MODE == \"count\" and checked_count >= MAX_ATTEMPTS:\n",
    "                stop_flag = True\n",
    "                break\n",
    "            \n",
    "            # Submit new tasks to keep the pool busy\n",
    "            while len(futures) < max_workers * 2:\n",
    "                try:\n",
    "                    username = next(username_iter)\n",
    "                except StopIteration:\n",
    "                    stop_flag = True\n",
    "                    break\n",
    "                futures.add(executor.submit(check_username, username))\n",
    "            \n",
    "            # Process completed futures\n",
    "            done, futures = futures, set()\n",
    "            for future in as_completed(done):\n",
    "                try:\n",
    "                    future.result()\n",
    "                except:\n",
    "                    pass\n",
    "            \n",
    "            # Small sleep to avoid busy loop\n",
    "            time.sleep(0.1)\n",
    "            \n",
    "except KeyboardInterrupt:\n",
    "    print(f\"\\n{W}[!] Interrupted by user.\")\n",
    "    stop_flag = True\n",
    "\n",
    "print(\"\\n\" + \"=\"*50)\n",
    "print(f\"{F}✨ Complete! Checked {checked_count} usernames. Found {hit_count} available.\")\n",
    "send_telegram_message(f\"✅ InstaUserCheckBot finished.\\nChecked: {checked_count}\\nAvailable: {hit_count}\")\n",
    "if SAVE_AVAILABLE_TO_FILE and available_usernames:\n",
    "    print(f\"{W}Available usernames saved to {OUTPUT_FILENAME}\")\n",
    "    # In Colab, offer download link\n",
    "    from google.colab import files\n",
    "    files.download(OUTPUT_FILENAME)\n",
    "\n",
    "print(\"\\n---\")\n",
    "print(\"🤖 InstaUserCheckBot By [Shinei Nouzen](https://github.com/Shineii86)\")\n"
   ],
   "execution_count": null,
   "outputs": []
  },
